# TerminalTriage configuration.
# Copy this file to ".env" and fill in the values for the provider you use.
# Real environment variables take precedence over values in this file.

# Which AI provider to use: anthropic | openai | gemini
AI_PROVIDER=anthropic

# API key for the selected provider (only the matching one is required).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the model. If unset, a sensible default is chosen per provider:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-2.0-flash
# AI_MODEL=

# Optional: maximum tokens for the AI response (default: 4096).
# AI_MAX_TOKENS=4096

# Optional: path to the persistent command-history file.
# AI_HISTORY_FILE=~/.terminal_triage_history

# Optional: enable live kubectl tab-completion via `kubectl __complete`, which
# contacts the cluster for cluster-aware suggestions (CRDs, real namespace/pod
# names). Off by default; accepts 1/true/yes/on. Equivalent to the
# --kubectl-live-completion CLI flag.
# AI_KUBECTL_LIVE_COMPLETION=1
